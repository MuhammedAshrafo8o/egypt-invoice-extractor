# انسخ الملف ده باسم .env وعدّل القيم
# (سكريبت setup بيعمل النسخة دي أوتوماتيك)

# ---------- عام ----------
# مفتاح سري للجلسات. لو سبته فاضي هيتولد واحد ويتحفظ في data/.secret_key
SECRET_KEY=
# مكان قاعدة البيانات والملفات المرفوعة
DATA_DIR=data
# السماح لأي حد يعمل حساب من صفحة التسجيل
ALLOW_SIGNUP=true
MAX_UPLOAD_MB=15
HOST=127.0.0.1
PORT=8000
# خليها true لما تشغّل على سيرفر عليه HTTPS
HTTPS_ONLY_COOKIES=false

# ---------- قراءة الصور والـ PDF الممسوح ----------
# الترتيب: لو فيه مفتاح ذكاء اصطناعي يتستخدم، غير كده القراءة المجانية (OCR)،
# ولو الذكاء الاصطناعي فشل (مثلًا خلص الحد المجاني) بيرجع للـ OCR أوتوماتيك.
USE_AI=true
USE_OCR=true
# اختياري: anthropic | gemini | openai  (لو فاضي بيختار أول واحد متظبط)
AI_PROVIDER=

# (1) Claude — الأدق. من https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# (2) Gemini — فيه خطة مجانية. من https://aistudio.google.com/apikey
#     ملحوظة: بيانات الخطة المجانية ممكن جوجل تستخدمها لتحسين خدماتها — للتجربة بس.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# (3) أي خدمة متوافقة مع OpenAI:
#     OpenRouter (موديلات :free)  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#     Ollama على جهازك (مجاني بالكامل) OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5vl
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# مكان برنامج Tesseract لو مش متعرف أوتوماتيك
TESSERACT_CMD=

# ---------- واتساب (WhatsApp Cloud API من Meta) ----------
# من https://developers.facebook.com → تطبيقك → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# أي كلمة تختارها، وتكتبها نفسها في إعدادات الـ Webhook عند Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret من Settings → Basic (للتحقق إن الرسائل جاية من Meta فعلًا)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
# رقم الواتساب اللي العملاء يبعتوا عليه الفواتير (بيتكتب في رسائل التذكير). اختياري.
WHATSAPP_DISPLAY_NUMBER=

# ---------- منظومة الفاتورة الإلكترونية ----------
# preprod للتجربة، prod للتشغيل الحقيقي،
# demo = محاكي داخل البرنامج (مش بيبعت أي حاجة للمصلحة) عشان تجرب الإصدار والمطابقة من غير بيانات دخول.
# (بيانات الدخول بتاعة كل عميل بتتكتب في صفحة العميل نفسه)
ETA_ENV=preprod
# مكتبة التوكن (PKCS#11) للتوقيع على الفواتير اللي بتطلع. محتاجة: pip install PyKCS11
# ويندوز ePass2003 / Egypt Trust:  C:\Windows\System32\eps2003csp11.dll
ETA_PKCS11_LIB=

# ---------- ميعاد الإقرار (بيظهر في الصفحة الرئيسية) ----------
# اليوم من الشهر التالي اللي آخره الإقرار. 0 = آخر يوم في الشهر التالي.
# راجع الميعاد الرسمي مع مصلحة الضرائب وعدّله لو مختلف (مثلًا 15).
VAT_DEADLINE_DAY=0
